NODE_ENV=development
PORT=3001
# Copy the direct connection string from Neon. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/sica_db?sslmode=require
# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Firebase project ID only; server uses Google Application Default Credentials.
FIREBASE_PROJECT_ID=SUBSTITUA_PELO_PROJECT_ID
