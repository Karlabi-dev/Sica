VITE_API_BASE_URL=http://localhost:3001

# Firebase Web SDK configuration (public client identifiers, not admin secrets).
# Copy this file to frontend/.env.local and replace the placeholders.
VITE_FIREBASE_API_KEY=SUBSTITUA_PELA_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=SUBSTITUA_PELO_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=SUBSTITUA_PELO_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=SUBSTITUA_PELO_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=SUBSTITUA_PELO_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=SUBSTITUA_PELO_APP_ID
